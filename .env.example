# Database connection. SQLite by default, no external services needed.
# Prisma 7 connects through a driver adapter, so pool options are handled by
# the driver rather than by URL parameters.
DATABASE_URL="file:./dev.db"

# Secret used to sign the session cookie. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Office timezone and working hours, in office time.
OFFICE_TIMEZONE="Europe/Kyiv"
OFFICE_OPEN_HOUR=9
OFFICE_CLOSE_HOUR=19

# Password for the seeded test users.
SEED_USER_PASSWORD="password123"

# How long before a booking ends its author is warned, in minutes.
NOTIFY_BEFORE_MINUTES=10
