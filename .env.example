# Підключення до бази. За замовчуванням SQLite — працює без зовнішніх сервісів.
# connection_limit=1 обовʼязковий: у SQLite один писач, і без серіалізації
# паралельні транзакції бронювання блокують одна одну.
DATABASE_URL="file:./dev.db?connection_limit=1"

# Секрет для підпису сесійного cookie. Згенерувати свій:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Часовий пояс офісу та робочі години (у часі офісу).
OFFICE_TIMEZONE="Europe/Kyiv"
OFFICE_OPEN_HOUR=9
OFFICE_CLOSE_HOUR=19

# Пароль тестових користувачів із сіда.
SEED_USER_PASSWORD="password123"
